name: dockercompose4276168124367813709
services:
  seq:
    container_name: ydot-seq
    environment:
      ACCEPT_EULA: 'Y'
      SEQ_FIRSTRUN_NOAUTHENTICATION: "true"
    image: datalust/seq:latest
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 80
        published: "6711"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: ydot-seq-data
        target: /data
        volume: {}
  ydot-cam:
    build:
      context: D:\Permaspace\Phase1\YDots\src
      dockerfile: Services/CAM/YDots.CAM.API/Dockerfile
    container_name: ydot-cam
    depends_on:
      ydot-postgres:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      CampaignSettings__AllowLaunchWithOutstandingChecks: "false"
      CampaignSettings__TrackingBaseUrl: http://localhost:6700/give
      ClientAppSettings__AllowedOrigins__0: http://localhost:6700
      ClientAppSettings__AllowedOrigins__1: http://localhost:6701
      ClientAppSettings__BaseUrl: http://localhost:6700
      DatabaseSettings__ApplyMigrationsOnStartup: "true"
      DatabaseSettings__ConnectionString: Host=ydot-postgres;Port=5432;Database=ydotphaseupdated;Username=postgres;Password=user;Include
        Error Detail=true
      DatabaseSettings__SeedOnStartup: "true"
      JwtSettings__Audience: YDot.Clients
      JwtSettings__Issuer: YDot.IAM
      JwtSettings__SigningKey: ydot-iam-docker-signing-key-please-replace-in-every-real-environment-2026
      Seq__ServerUrl: http://seq:5341
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://127.0.0.1:8080/health || exit 1
      timeout: 5s
      interval: 15s
      retries: 10
      start_period: 1m30s
    image: sivan67906/ydot-cam:8.9.2
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 8080
        published: "6704"
        protocol: tcp
    restart: unless-stopped
  ydot-don:
    build:
      context: D:\Permaspace\Phase1\YDots\src
      dockerfile: Services/DON/YDots.DON.Api/Dockerfile
    container_name: ydot-don
    depends_on:
      ydot-postgres:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ClientAppSettings__AllowedOrigins__0: http://localhost:6700
      ClientAppSettings__AllowedOrigins__1: http://localhost:6701
      ClientAppSettings__BaseUrl: http://localhost:6700
      DatabaseSettings__ApplyMigrationsOnStartup: "true"
      DatabaseSettings__ConnectionString: Host=ydot-postgres;Port=5432;Database=ydotphaseupdated;Username=postgres;Password=user;Include
        Error Detail=true
      DatabaseSettings__SeedOnStartup: "true"
      JwtSettings__Audience: YDot.Clients
      JwtSettings__Issuer: YDot.IAM
      JwtSettings__SigningKey: ydot-iam-docker-signing-key-please-replace-in-every-real-environment-2026
      SeedSettings__OrganisationId: 9fb11890-a08e-4adc-95ca-8e4d71f4dd21
      Seq__ServerUrl: http://seq:5341
      Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore.Database.Command: Information
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://127.0.0.1:8080/health || exit 1
      timeout: 5s
      interval: 15s
      retries: 10
      start_period: 1m30s
    image: sivan67906/ydot-don:8.9.2
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 8080
        published: "6706"
        protocol: tcp
    restart: unless-stopped
  ydot-iam:
    build:
      context: D:\Permaspace\Phase1\YDots\src
      dockerfile: Services/IAM/YDot.IAM.Api/Dockerfile
    container_name: ydot-iam
    depends_on:
      ydot-minio:
        condition: service_healthy
        required: true
      ydot-postgres:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ASPNETCORE_HTTP_PORTS: "8080"
      ClientAppSettings__AllowedOrigins__0: http://localhost:6700
      ClientAppSettings__AllowedOrigins__1: http://localhost:6701
      ClientAppSettings__AllowedOrigins__2: http://ten1.localhost:6700
      ClientAppSettings__AllowedOrigins__3: http://ten2.localhost:6700
      ClientAppSettings__AllowedOrigins__4: http://ten3.localhost:6700
      ClientAppSettings__AllowedOrigins__5: http://ten4.localhost:6700
      ClientAppSettings__AllowedOrigins__6: http://ten5.localhost:6700
      ClientAppSettings__BaseUrl: http://localhost:6700
      DatabaseSettings__ApplyMigrationsOnStartup: "true"
      DatabaseSettings__ConnectionString: Host=ydot-postgres;Port=5432;Database=ydotphaseupdated;Username=postgres;Password=user;Include
        Error Detail=true
      DatabaseSettings__SeedOnStartup: "true"
      DocumentStorageSettings__AccessKey: ydotminio
      DocumentStorageSettings__BucketName: ydot-organisation-documents
      DocumentStorageSettings__DownloadLinkExpirySeconds: "300"
      DocumentStorageSettings__Endpoint: ydot-minio:9000
      DocumentStorageSettings__MaximumFileSizeMegabytes: "5"
      DocumentStorageSettings__MaximumFilesPerSubmission: "10"
      DocumentStorageSettings__PublicEndpoint: localhost:6712
      DocumentStorageSettings__PublicUseSsl: "false"
      DocumentStorageSettings__SecretKey: ydotminio2026
      DocumentStorageSettings__UseSsl: "false"
      EmailSettings__Enabled: "true"
      EmailSettings__RedirectAllToAddress: ""
      EmailSettings__SenderAddress: notifications@ascendingsoftware.com
      EmailSettings__SenderName: Your Application
      EmailSettings__SmtpHost: smtp.hostinger.com
      EmailSettings__SmtpPassword: NoTiFy@As#$$645^
      EmailSettings__SmtpPort: "465"
      EmailSettings__SmtpUsername: notifications@ascendingsoftware.com
      JwtSettings__AccessTokenMinutes: "60"
      JwtSettings__Audience: YDot.Clients
      JwtSettings__Issuer: YDot.IAM
      JwtSettings__RefreshTokenCookieSameSite: Lax
      JwtSettings__RefreshTokenCookieSecure: "false"
      JwtSettings__SigningKey: ydot-iam-docker-signing-key-please-replace-in-every-real-environment-2026
      SeedSettings__Enabled: "true"
      SeedSettings__RoleAccountPassword: YDot@2026Demo
      SeedSettings__RootDomain: localhost
      SeedSettings__SampleOrganisationId: 9fb11890-a08e-4adc-95ca-8e4d71f4dd21
      SeedSettings__SeedSampleTenants: "true"
      SeedSettings__SuperAdminEmail: rajat.sivan@gmail.com
      SeedSettings__SuperAdminFirstName: Platform
      SeedSettings__SuperAdminLastName: Administrator
      SeedSettings__SuperAdminPassword: SuperAdmin@2026
      SeedSettings__SuperAdminUsername: superadmin
      Seq__ServerUrl: http://seq:5341
      Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore.Database.Command: Information
      TenancySettings__AllowHeaderOverrideOnLoopback: "true"
      TenancySettings__EnforceTokenHostBinding: "true"
      TenancySettings__PlatformHosts__0: localhost
      TenancySettings__PlatformHosts__1: 127.0.0.1
      TenancySettings__PlatformHosts__2: ydot-iam
      TenancySettings__RootDomain: localhost
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://127.0.0.1:8080/health || exit 1
      timeout: 5s
      interval: 15s
      retries: 10
      start_period: 1m30s
    image: sivan67906/ydot-iam:8.9.2
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 8080
        published: "6702"
        protocol: tcp
    restart: unless-stopped
  ydot-minio:
    command:
      - server
      - /data
      - --console-address
      - :9001
    container_name: ydot-minio
    environment:
      MINIO_ROOT_PASSWORD: ydotminio2026
      MINIO_ROOT_USER: ydotminio
    healthcheck:
      test:
        - CMD
        - mc
        - ready
        - local
      timeout: 5s
      interval: 10s
      retries: 12
      start_period: 15s
    image: minio/minio:RELEASE.2025-04-22T22-12-26Z
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 9000
        published: "6712"
        protocol: tcp
      - mode: ingress
        target: 9001
        published: "6713"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: ydot-minio-data
        target: /data
        volume: {}
  ydot-pay:
    build:
      context: D:\Permaspace\Phase1\YDots\src
      dockerfile: Services/PAY/YDot.PAY.Api/Dockerfile
    container_name: ydot-pay
    depends_on:
      ydot-postgres:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ClientAppSettings__AllowedOrigins__0: http://localhost:6700
      ClientAppSettings__AllowedOrigins__1: http://localhost:6701
      ClientAppSettings__BaseUrl: http://localhost:6700
      DatabaseSettings__ApplyMigrationsOnStartup: "true"
      DatabaseSettings__ConnectionString: Host=ydot-postgres;Port=5432;Database=ydotphaseupdated;Username=postgres;Password=user;Include
        Error Detail=true
      DatabaseSettings__SeedOnStartup: "false"
      EmailSettings__Enabled: "true"
      EmailSettings__RedirectAllToAddress: ""
      EmailSettings__SenderAddress: notifications@ascendingsoftware.com
      EmailSettings__SenderName: Your Application
      EmailSettings__SmtpHost: smtp.hostinger.com
      EmailSettings__SmtpPassword: NoTiFy@As#$$645^
      EmailSettings__SmtpPort: "465"
      EmailSettings__SmtpUsername: notifications@ascendingsoftware.com
      IdentityIntegration__BaseUrl: http://ydot-iam:8080
      IdentityIntegration__Enabled: "false"
      JwtSettings__Audience: YDot.Clients
      JwtSettings__Issuer: YDot.IAM
      JwtSettings__SigningKey: ydot-iam-docker-signing-key-please-replace-in-every-real-environment-2026
      PaymentGateways__Razorpay__ApiKey: rzp_test_TVq7S0FMwQ3uYH:9Zbz9eXre1436J8SCZnerNNc
      PaymentGateways__Razorpay__BaseUrl: https://api.razorpay.com/v1/
      PaymentGateways__Razorpay__WebhookSecret: ""
      PaymentSettings__AutoDeliverReceipt: "true"
      PaymentSettings__AutoIssueReceiptOnDonation: "true"
      PaymentSettings__DefaultPaymentLinkValidityMinutes: "60"
      PaymentSettings__FinancialYearStartMonth: "4"
      PaymentSettings__MaximumAttemptsBeforeSupport: "3"
      PaymentSettings__ReceiptDocumentRoot: /var/ydot/receipts
      Seq__ServerUrl: http://seq:5341
    healthcheck:
      test:
        - CMD-SHELL
        - curl -fsS http://127.0.0.1:8080/health || exit 1
      timeout: 5s
      interval: 15s
      retries: 10
      start_period: 1m30s
    image: sivan67906/ydot-pay:8.9.2
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 8080
        published: "6708"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: ydot-pay-receipts
        target: /var/ydot/receipts
        volume: {}
  ydot-pay-gateway-seed:
    container_name: ydot-pay-gateway-seed
    depends_on:
      ydot-pay:
        condition: service_healthy
        required: true
    entrypoint:
      - sh
      - -c
      - psql -h ydot-postgres -U postgres -d ydotphaseupdated -v ON_ERROR_STOP=1 -f
        /sql/razorpay-test-gateway.sql || echo 'Gateway seed skipped; configure it
        on the Payment Gateway screen.'
    environment:
      PGPASSWORD: user
    image: postgres:16-alpine
    networks:
      ydot-network: null
    restart: 'no'
    volumes:
      - type: bind
        source: D:\Permaspace\Phase1\YDots\src\docker\sql
        target: /sql
        read_only: true
        bind: {}
  ydot-postgres:
    build:
      context: D:\Permaspace\Phase1\YDots\src\docker\postgres
      dockerfile: Dockerfile
    container_name: ydot-postgres
    environment:
      PGDATA: /var/lib/postgresql/data/pgdata
      POSTGRES_DB: ydotphaseupdated
      POSTGRES_PASSWORD: user
      POSTGRES_USER: postgres
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U postgres -d ydotphaseupdated
      timeout: 5s
      interval: 10s
      retries: 12
      start_period: 20s
    image: sivan67906/ydot-postgres:8.9.2
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 5432
        published: "6710"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: ydot-postgres-data
        target: /var/lib/postgresql/data
        volume: {}
  ydot-ui:
    build:
      context: D:\Permaspace\Phase1\YDots\src\UI\YDots.UI
      dockerfile: Dockerfile
      args:
        BUILD_CONFIGURATION: docker
    container_name: ydot-ui
    depends_on:
      ydot-cam:
        condition: service_started
        required: true
      ydot-don:
        condition: service_started
        required: true
      ydot-iam:
        condition: service_started
        required: true
      ydot-pay:
        condition: service_started
        required: true
    image: sivan67906/ydot-ui:8.9.2
    networks:
      ydot-network: null
    ports:
      - mode: ingress
        target: 80
        published: "6700"
        protocol: tcp
    restart: unless-stopped
networks:
  ydot-network:
    name: dockercompose4276168124367813709_ydot-network
    driver: bridge
volumes:
  ydot-minio-data:
    name: dockercompose4276168124367813709_ydot-minio-data
  ydot-pay-receipts:
    name: dockercompose4276168124367813709_ydot-pay-receipts
  ydot-postgres-data:
    name: dockercompose4276168124367813709_ydot-postgres-data
  ydot-seq-data:
    name: dockercompose4276168124367813709_ydot-seq-data